VOX_SUPABASE_URL=https://your-project-id.supabase.co
VOX_SUPABASE_ANON_KEY=your-supabase-anon-key
VOX_API_URL=https://api.voxagent.in
VOX_BRIDGE_URL=https://api.voxagent.in
# Release / installed app:
VOX_OAUTH_REDIRECT_URI=vox://auth/callback
# Debug (`cargo tauri dev`) ignores vox:// and uses http://127.0.0.1:17843/auth/callback — allow that URL in Supabase too.
