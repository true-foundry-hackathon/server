VOX_SUPABASE_URL=https://your-project-id.supabase.co
VOX_SUPABASE_ANON_KEY=your-supabase-anon-key
VOX_API_URL=https://api.voxagent.in
VOX_BRIDGE_URL=https://api.voxagent.in
# Release / installed app: a real HTTPS page (vox-bridge) that shows Vox's
# branding, then hands off to vox://auth/callback — browsers can't render a
# page at a vox:// URL directly, so Supabase must redirect to this bridge.
VOX_OAUTH_REDIRECT_URI=https://api.voxagent.in/auth/bridge
# Add this URL to Supabase Auth's redirect allow-list.
# Debug (`cargo tauri dev`) ignores this and uses http://127.0.0.1:17843/auth/callback instead — allow that URL in Supabase too.

# Optional: Places API (New) for naming the building under you on the home map.
# Map itself is MapLibre (no Google Maps / Map Tiles needed).
GOOGLE_MAPS_API_KEY=
# Aliases: VITE_GOOGLE_MAPS_API_KEY=  VOX_GOOGLE_MAPS_API_KEY=
