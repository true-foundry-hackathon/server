# Vox Core Configuration
# On Railway, VOX_CORE_BIND_ADDRESS can be left unset -- Core falls back to
# binding 0.0.0.0:$PORT (Railway injects PORT automatically for every service).
VOX_CORE_BIND_ADDRESS=0.0.0.0:3001
VOX_AUTH_TOKEN=change-me-to-a-secure-shared-token
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Pool tuning; defaults to 10 connections / 5s acquire timeout if unset.
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5
# On Railway, set this to the Redis plugin's connection string reference:
# ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:6379
# On Railway, set this to Bridge's private networking URL:
# http://bridge.railway.internal:3000
VOX_BRIDGE_URL=http://localhost:3000
# Defaults to https://api.typesafe.ai/v1/systemone if unset.
JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# AI Models & Tools
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
EXA_API_KEY=your-exa-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Just the provider name Core mentions in prompts; the actual TTS/STT
# credentials (Twilio/AssemblyAI/Sarvam/ElevenLabs) live on Bridge only.
VOX_TTS_PROVIDER=sarvam

# Dedicated read-only administration credential; keep separate from service token.
VOX_ADMIN_TOKEN=
