FROM rust:1.91-slim-bookworm AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY vox-connections ./vox-connections
COPY vox-shared ./vox-shared
COPY services ./services
COPY src ./src
COPY migrations ./migrations
COPY schema ./schema
COPY contracts ./contracts
RUN cargo build --release --locked --bin vox-core-worker

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates curl libssl3 && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 -U vox
USER vox
WORKDIR /app
COPY --from=builder --chown=vox:vox /app/target/release/vox-core-worker /usr/local/bin/vox-core-worker
CMD ["/usr/local/bin/vox-core-worker"]
